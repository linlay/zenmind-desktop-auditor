{
  "schemaVersion": 2,
  "id": "webapp-2a2b2dd9766e2390",
  "key": "dag-lab",
  "label": "DAG Lab",
  "version": "0.2.0",
  "target": "any",
  "appConfig": {
    "purpose": "Browser-first DAG workflows powered by Platform HTTP Bridge"
  },
  "frontend": {
    "root": "frontend",
    "index": "index.html",
    "routeConfig": {
      "backendPrefixes": [
        "/api"
      ]
    }
  },
  "backend": {
    "command": {
      "type": "electron-node",
      "entry": "backend/server.mjs"
    },
    "health": {
      "type": "http",
      "path": "/api/health",
      "startupTimeoutMs": 10000
    },
    "shutdownTimeoutMs": 3000
  }
}
